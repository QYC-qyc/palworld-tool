[Unit]
Description=PalAdmin - Palworld Server Admin & Anticheat
After=network.target

[Service]
Type=simple
User=paladmin
WorkingDirectory=/opt/paladmin
ExecStart=/opt/paladmin/paladmin --config /opt/paladmin/config.yaml
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

# 若要回档时控制游戏服（systemd 模式），配置：
# PROCESS__MODE=systemd
# PROCESS__SERVICE=palworld
Environment=PROCESS__MODE=systemd
Environment=PROCESS__SERVICE=palworld

[Install]
WantedBy=multi-user.target
