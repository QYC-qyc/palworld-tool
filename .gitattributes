# 统一换行符，消除 LF/CRLF 警告
# 默认在仓库中使用 LF
* text=auto eol=lf

# 文本文件强制 LF
*.go       text eol=lf
*.py       text eol=lf
*.js       text eol=lf
*.ts       text eol=lf
*.vue      text eol=lf
*.json     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.md       text eol=lf
*.sh       text eol=lf
*.service  text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.proto    text eol=lf
Makefile   text eol=lf
Dockerfile text eol=lf
.gitignore text eol=lf

# Windows 脚本保留 CRLF（在 Windows 环境执行）
*.bat      text eol=crlf
*.ps1      text eol=crlf

# 二进制文件不做换行转换
*.exe      binary
*.dll      binary
*.so       binary
*.db       binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.zip      binary
*.tar      binary
*.gz       binary
*.woff*    binary
